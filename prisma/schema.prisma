// Sistema de gestión interno — sier-kse
// Prisma schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum VenueStatus {
  PROSPECT
  INSTALLED
  ACTIVE
  PAUSED
  CANCELLED
}

enum CostCategory {
  CAMERA
  LABOR
  TRAVEL
  HARDWARE
  CONNECTIVITY
  OTHER
}

enum AttachmentKind {
  CONTRACT
  PHOTO
  INVOICE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdVenues       Venue[]           @relation("VenueCreatedBy")
  cloudAccessLogs     CloudAccessLog[]
  apiKeysCreated      ApiKey[]          @relation("ApiKeyCreatedBy")
  attachmentsUploaded VenueAttachment[] @relation("AttachmentUploadedBy")
}

model Sport {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  venues    Venue[]
  createdAt DateTime @default(now())
}

model Venue {
  id        String      @id @default(cuid())
  name      String
  address   String
  city      String?
  country   String?
  latitude  Float
  longitude Float
  sportId   Int
  sport     Sport       @relation(fields: [sportId], references: [id])
  status    VenueStatus @default(PROSPECT)

  ownerName  String?
  ownerPhone String?
  ownerEmail String?
  notes      String?

  cloudActive      Boolean   @default(false)
  cloudActivatedAt DateTime?

  pricePerDownload Decimal? @db.Decimal(10, 2)
  revenueSharePct  Decimal? @db.Decimal(5, 2)
  currency         String   @default("USD")

  createdById String
  createdBy   User     @relation("VenueCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  costs       InstallationCost[]
  downloads   DownloadRecord[]
  cloudLogs   CloudAccessLog[]
  attachments VenueAttachment[]

  @@index([status])
  @@index([sportId])
  @@index([latitude, longitude])
}

model InstallationCost {
  id          String       @id @default(cuid())
  venueId     String
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("USD")
  incurredAt  DateTime
  createdAt   DateTime     @default(now())

  @@index([venueId])
}

model DownloadRecord {
  id              String   @id @default(cuid())
  venueId         String
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  downloads       Int
  unitPrice       Decimal? @db.Decimal(10, 2)
  revenueSharePct Decimal? @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([venueId, year, month])
  @@index([year, month])
}

model CloudAccessLog {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  active      Boolean
  changedAt   DateTime @default(now())
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  reason      String?

  @@index([venueId, changedAt])
}

model VenueAttachment {
  id           String         @id @default(cuid())
  venueId      String
  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  kind         AttachmentKind @default(OTHER)
  filename     String
  storedName   String         @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User           @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now())

  @@index([venueId])
}

model ApiKey {
  id          String    @id @default(cuid())
  provider    String
  label       String
  ciphertext  String
  iv          String
  authTag     String
  lastFour    String
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rotatedAt   DateTime?

  @@unique([provider, label])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
