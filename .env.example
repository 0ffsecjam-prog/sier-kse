# =======================================================
# sier-kse — plantilla de variables de entorno
# Copiar a .env.docker y rellenar con valores reales.
# .env.docker está en .gitignore — NUNCA committearlo.
# =======================================================

# --- Postgres ---
POSTGRES_USER=sier
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=sier
# Dentro del compose, el host de la DB es el nombre del servicio: "db"
DATABASE_URL=postgresql://sier:change-me-please@db:5432/sier?schema=public

# --- NextAuth / Auth.js ---
# URL pública desde donde se accede a la app. Cambiar al IP/dominio real si no es localhost.
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Encriptación de API keys (AES-256-GCM) ---
# 32 bytes en hex = 64 caracteres. Generar con: openssl rand -hex 32
# IMPORTANTE: si se pierde esta key, las API keys guardadas son irrecuperables.
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# --- Admin inicial (se crea automáticamente al primer arranque) ---
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_PASSWORD=change-me-now
INITIAL_ADMIN_NAME=Admin

# --- Almacenamiento ---
# Dentro del container. Bind-mounted a ./data/uploads desde el host.
UPLOADS_DIR=/app/data/uploads

# --- App ---
NODE_ENV=production
